# ============================================
# VEHICLE OSINT BOT - ENVIRONMENT VARIABLES
# ============================================

# Telegram Bot Token (Required)
# Get from @BotFather on Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default timeout for requests (seconds)
REQUEST_TIMEOUT=15

# User Agent for requests
USER_AGENT=Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Mobile Safari/537.36

# ============================================
# DEPLOYMENT SETTINGS (For Vercel/Railway)
# ============================================

# Vercel Environment
VERCEL_ENV=production

# Webhook URL (for Vercel)
# WEBHOOK_URL=https://your-app.vercel.app/

# ============================================
# RATE LIMITING (Optional)
# ============================================

# Maximum requests per user per minute
RATE_LIMIT_PER_MINUTE=5

# Maximum requests per user per day
RATE_LIMIT_PER_DAY=100
